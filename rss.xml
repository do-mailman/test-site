---
layout: null
permalink: /rss.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <description>{{ site.description | xml_escape }}</description>
    <language>ja</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>

    {% assign rss_posts = site.posts | where_exp: "item", "item.rss == true" %}
    {% assign rss_pages = site.pages | where_exp: "item", "item.rss == true" %}
    {% assign rss_entries = rss_posts | concat: rss_pages | sort: "date" | reverse %}

    {% for p in rss_entries limit: 50 %}
    {% if p.title and p.date %}
    <item>
      <title>{{ p.title | xml_escape }}</title>
      <link>{{ site.url }}{{ site.baseurl }}{{ p.url }}</link>
      <guid>{{ site.url }}{{ site.baseurl }}{{ p.url }}</guid>
      <pubDate>{{ p.date | date_to_rfc822 }}</pubDate>
      <description>{{ p.excerpt | strip_html | normalize_whitespace | xml_escape }}</description>
    </item>
    {% endif %}
    {% endfor %}
  </channel>
</rss>
